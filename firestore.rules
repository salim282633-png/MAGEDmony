rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // Collection rules
    match /budgets/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /debts/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /savings/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /expenses/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /tasks/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /goals/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /transactions/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /accounts/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /investments/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /subscriptions/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /financial_events/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /settings/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /monthly_closures/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
